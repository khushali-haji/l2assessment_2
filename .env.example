# LLM Configuration
#
# Any OpenAI-compatible chat-completions endpoint works. OpenRouter is the default.
# Get a key from: https://openrouter.ai/keys

VITE_LLM_API_KEY=sk-or-v1-your_key_here

# Optional — both have working defaults, override only to change provider or model.
#
#   OpenRouter (default)
#     VITE_LLM_BASE_URL=https://openrouter.ai/api/v1
#     VITE_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#     Browse model IDs at https://openrouter.ai/models. Models ending in ":free"
#     need no credit but are tightly rate limited, and which ones are free
#     changes over time — see LLM-SETUP.md for how to list the current set.
#
#   Groq
#     VITE_LLM_BASE_URL=https://api.groq.com
#     VITE_LLM_MODEL=llama-3.3-70b-versatile

# VITE_LLM_BASE_URL=
# VITE_LLM_MODEL=

# Note: In a production environment, API keys should NEVER be exposed in the browser.
# This setup is for local development and assessment purposes only.
